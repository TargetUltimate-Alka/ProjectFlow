# ==============================================================
# ProjectFlow Configuration (.env)
# ==============================================================

# MongoDB Connection String
# --------------------------------------------------------------
# Option 1: MongoDB Atlas (Cloud - Recommended & Free)
# Replace with your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Option 2: Local MongoDB Community Server (default local port 27017)
MONGODB_URI=mongodb://localhost:27017

# Option 3: Docker MongoDB (with root credentials from docker-compose.yml)
# MONGODB_URI=mongodb://admin:password123@localhost:27017/?authSource=admin

# --------------------------------------------------------------
# Microservice Ports
# --------------------------------------------------------------
GATEWAY_PORT=5000
AUTH_PORT=5001
PROJECT_PORT=5002
TASK_PORT=5003
EVALUATION_PORT=5004
INTEGRATION_PORT=5005
NOTIFICATION_PORT=5006

# --------------------------------------------------------------
# Security
# --------------------------------------------------------------
JWT_SECRET=projectflow_super_secret_jwt_key_2026
